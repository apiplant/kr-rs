# Maintainer: apiplant <releases@apiplant.com>
#
# Built by the release workflow, which fills in the version and checksum and
# publishes the resulting package to apiplant.github.io/pacman. It is not an
# AUR manifest: it installs the binary the release already built.
pkgname=kr-rs
pkgver=@VERSION@
pkgrel=1
pkgdesc="Kubernetes in one static binary: no libc, no third-party crates"
arch=('x86_64')
url="https://github.com/apiplant/kr-rs"
license=('Apache-2.0')
depends=()
# The release archive holding the binary, the systemd units and the README. The
# workflow builds the package before the release exists and drops the archive
# next to this file, which makepkg picks up instead of downloading; the URL is
# what makes the PKGBUILD work on its own once the release is published.
source=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/kr-rs-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('@SHA_LINUX_X86_64@')
# The release profile already strips symbols.
options=('!strip' '!debug')

package() {
  local src="$srcdir/kr-rs-v$pkgver-x86_64-unknown-linux-gnu"
  install -Dm755 "$src/kr" "$pkgdir/usr/bin/kr"
  for unit in kr-server kr-agent; do
    install -Dm644 "$src/systemd/$unit.service" "$pkgdir/usr/lib/systemd/system/$unit.service"
    # The archive's units name /usr/local/bin/kr; the package installs to /usr/bin.
    sed -i 's#/usr/local/bin/kr#/usr/bin/kr#' "$pkgdir/usr/lib/systemd/system/$unit.service"
  done
  install -Dm644 "$src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
